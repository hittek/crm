generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Organization model - multi-tenancy support
model Organization {
  id          Int       @id @default(autoincrement())
  name        String
  slug        String    @unique // URL-friendly identifier
  logo        String?
  favicon     String?
  primaryColor   String?  @default("#2563eb")
  secondaryColor String?  @default("#7c3aed")
  currency    String    @default("MXN")
  timezone    String    @default("America/Mexico_City")
  locale      String    @default("es-MX")
  isActive    Boolean   @default(true)
  orgSettings String?   // JSON for org-specific settings

  // SaaS billing & plan
  plan                 String    @default("trial")     // trial, starter, pro, enterprise
  planStatus           String    @default("trialing")  // trialing, active, past_due, canceled, suspended
  trialEndsAt          DateTime?
  stripeCustomerId     String?
  stripeSubscriptionId String?
  planLimits           String?   // JSON: { contacts: 50, users: 3, deals: 50, chatbots: 0 }
  customDomain         String?   @unique
  suspendedAt          DateTime?
  suspendedReason      String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  users         User[]
  contacts      Contact[]
  deals         Deal[]
  tasks         Task[]
  activities    Activity[]
  savedViews    SavedView[]
  auditLogs     AuditLog[]
  notifications Notification[]
  knowledgeBases KnowledgeBase[]
  chatbots      Chatbot[]
  channelConfigs ChannelConfig[]
}

// Contact model - the core entity in a contacts-first CRM
model Contact {
  id          Int       @id @default(autoincrement())
  firstName   String
  lastName    String
  email       String?
  phone       String?
  mobile      String?
  company     String?
  role        String?
  address     String?
  city        String?
  state       String?
  country     String?
  postalCode  String?
  website     String?
  linkedin    String?
  twitter     String?
  source      String?   // referral, website, cold-call, etc.
  status      String    @default("active") // active, inactive, lead, prospect
  tags        String?   // comma-separated tags
  notes       String?
  aiSummary   String?   // AI-generated customer context from chat conversations
  avatar      String?
  isPrivate   Boolean   @default(false)
  visibility  String    @default("org") // org = visible to all, private = only owner/assigned users
  visibleTo   String?   // JSON array of user IDs when visibility is 'private'
  ownerId     Int?      // Owner user
  owner       User?     @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  organizationId Int    // Organization this contact belongs to
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String?
  updatedBy   String?

  // Relations
  deals         Deal[]
  tasks         Task[]
  activities    Activity[]
  conversations Conversation[]
  quotes        Quote[]

  @@unique([email, organizationId]) // Email unique per organization
  @@index([organizationId])
}

// Deal/Opportunity model - for the pipeline view
model Deal {
  id              Int       @id @default(autoincrement())
  title           String
  value           Float     @default(0)
  currency        String    @default("MXN")
  stage           String    @default("lead") // lead, qualified, proposal, negotiation, won, lost
  probability     Int       @default(10) // 0-100
  expectedClose   DateTime?
  actualClose     DateTime?
  description     String?
  lostReason      String?
  owner           String?
  priority        String    @default("medium") // low, medium, high
  tags            String?
  visibility      String    @default("org") // org = visible to all, private = only owner/assigned users
  visibleTo       String?   // JSON array of user IDs when visibility is 'private'
  ownerId         Int?      // Owner user
  ownerUser       User?     @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  organizationId  Int       // Organization this deal belongs to
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdBy       String?
  updatedBy       String?

  // Relations
  contactId       Int?
  contact         Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  tasks           Task[]
  activities      Activity[]
  quotes          Quote[]

  @@index([organizationId])
}

// Task model - for task management
model Task {
  id            Int       @id @default(autoincrement())
  title         String
  description   String?
  status        String    @default("pending") // pending, in-progress, completed, cancelled
  priority      String    @default("medium") // low, medium, high
  dueDate       DateTime?
  dueTime       String?   // HH:mm format
  reminderDate  DateTime?
  completedAt   DateTime?
  type          String    @default("task") // task, call, email, meeting
  isRecurring   Boolean   @default(false)
  recurringRule String?   // iCal RRULE format
  owner         String?
  visibility    String    @default("org") // org = visible to all, assignee = only assigned user
  assignedToId  Int?      // User responsible for the task
  assignedTo    User?     @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  ownerId       Int?      // Owner/creator user
  ownerUser     User?     @relation("TaskOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  organizationId Int      // Organization this task belongs to
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdBy     String?
  updatedBy     String?

  // Relations
  contactId     Int?
  contact       Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  dealId        Int?
  deal          Deal?     @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@index([organizationId])
}

// Activity model - timeline of interactions
model Activity {
  id            Int       @id @default(autoincrement())
  type          String    // email, call, meeting, note, task_completed, deal_updated, etc.
  subject       String
  content       String?
  outcome       String?   // for calls: answered, voicemail, no-answer
  duration      Int?      // in minutes
  isPrivate     Boolean   @default(false)
  metadata      String?   // JSON for extra data
  organizationId Int      // Organization this activity belongs to
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdBy     String?

  // Relations
  contactId     Int?
  contact       Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  dealId        Int?
  deal          Deal?     @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@index([organizationId])
}

// User model - for authentication and ownership
model User {
  id          Int       @id @default(autoincrement())
  email       String
  password    String?   // Hashed password (nullable for migration, required for new users)
  name        String
  avatar      String?
  role        String    @default("user") // admin, manager, user
  timezone    String    @default("America/Mexico_City")
  locale      String    @default("es-MX")
  isActive    Boolean   @default(true)
  preferences String?   // JSON for user preferences
  lastLoginAt DateTime? // Track last login time
  isSuperAdmin Boolean  @default(false) // Hittek platform super-admins
  organizationId Int    // Organization this user belongs to
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  assignedTasks   Task[]          @relation("TaskAssignee")
  ownedTasks      Task[]          @relation("TaskOwner")
  ownedContacts   Contact[]       @relation("ContactOwner")
  ownedDeals            Deal[]          @relation("DealOwner")
  auditLogs             AuditLog[]
  notifications         Notification[]
  assignedConversations Conversation[]  @relation("ConversationAssignee")
  convEventActions      ConversationEvent[] @relation("ConversationEventActor")
  convEventTargets      ConversationEvent[] @relation("ConversationEventTarget")

  @@unique([email, organizationId]) // Email unique per organization
  @@index([organizationId])
}

// SavedView model - for saved filters/views
model SavedView {
  id          Int       @id @default(autoincrement())
  name        String
  entity      String    // contacts, deals, tasks
  filters     String    // JSON filters
  columns     String?   // JSON column configuration
  sortBy      String?
  sortOrder   String    @default("asc")
  isDefault   Boolean   @default(false)
  isShared    Boolean   @default(false)
  organizationId Int    // Organization this view belongs to
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([organizationId])
}

// AuditLog model - tracks all user actions for activity timeline
model AuditLog {
  id          Int       @id @default(autoincrement())
  action      String    // created, updated, deleted, completed, stage_changed, assigned, etc.
  entity      String    // contact, deal, task, user, settings
  entityId    Int?      // ID of the affected entity
  entityName  String?   // Human-readable name (e.g., "Llamar a Juan")
  details     String?   // JSON with additional details (old/new values, etc.)
  userId      Int?      // User who performed the action
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName    String?   // Cached user name for display
  organizationId Int?   // Organization context
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime  @default(now())

  @@index([entity, entityId])
  @@index([userId])
  @@index([organizationId])
  @@index([createdAt])
}

// ─── Chatbot / Knowledge Base ───────────────────────────────────────────────

// One knowledge base per chatbot configuration (one per org on Starter)
model KnowledgeBase {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  status      String    @default("empty") // empty | indexing | ready | error
  orgId       Int
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String?

  documents   KnowledgeBaseDocument[]
  chatbots    Chatbot[]

  @@index([orgId])
}

// A single source ingested into a knowledge base
model KnowledgeBaseDocument {
  id              Int            @id @default(autoincrement())
  knowledgeBaseId Int
  knowledgeBase   KnowledgeBase  @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  orgId           Int
  type            String         // pdf | url | qa
  title           String
  content         String?        // raw extracted text (plain)
  fileUrl         String?        // Blob URL for PDFs
  sourceUrl       String?        // original URL for scraped docs
  question        String?        // Q&A: question
  answer          String?        // Q&A: answer
  fileSize        Int?           // bytes
  status          String         @default("pending") // pending | processing | chunked | error
  errorMessage    String?
  chunkCount      Int            @default(0)
  metadata        String?        // JSON
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  chunks  KnowledgeBaseChunk[]

  @@index([knowledgeBaseId])
  @@index([orgId])
}

// A chunk of text ready for embedding (vectors added in S02)
model KnowledgeBaseChunk {
  id          Int                    @id @default(autoincrement())
  documentId  Int
  document    KnowledgeBaseDocument  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  kbId        Int
  orgId       Int
  content     String                 // chunk text
  chunkIndex  Int
  tokenCount  Int                    @default(0)
  embedded    Boolean                @default(false) // true once Voyage embedding stored
  embedding   Unsupported("vector(512)")?  // voyage-3-lite = 512 dims
  metadata    String?                // JSON (page number, heading, etc.)
  createdAt   DateTime               @default(now())

  @@index([kbId])
  @@index([documentId])
  @@index([orgId])
}

// ─── Chatbot models ──────────────────────────────────────────────────────────

model Chatbot {
  id               Int       @id @default(autoincrement())
  orgId            Int
  org              Organization @relation(fields: [orgId], references: [id])
  kbId             Int
  kb               KnowledgeBase @relation(fields: [kbId], references: [id])
  name             String
  greeting         String    @default("Hola, ¿en qué puedo ayudarte?")
  escalationPhrase String?   // phrase that triggers human escalation
  avatarUrl        String?
  primaryColor     String    @default("#2563eb")
  isActive         Boolean   @default(true)
  apiKey           String    @unique @default(cuid()) // used by widget + channel webhooks

  // ── CRM automation ───────────────────────────────────────────────────────
  // When enabled, a new Contact is auto-created if none is found for the session.
  autoCreateContact  Boolean  @default(false)
  // When enabled, a new Deal is opened the first time a (new) contact engages.
  autoCreateDeal     Boolean  @default(false)
  defaultDealStage   String?  // stage slug, defaults to 'lead'
  dealTitleTemplate  String?  // e.g. "Consulta vía WhatsApp" — {channel} interpolated

  // ── Claude tool-use capabilities ─────────────────────────────────────────
  // Comma-separated list of enabled tool names, e.g. "create_quote,create_contact"
  enabledTools       String?

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  conversations    Conversation[]
  channelConfigs   ChannelConfig[]
  quotes           Quote[]

  @@index([orgId])
  @@index([kbId])
}

model Conversation {
  id           Int       @id @default(autoincrement())
  chatbotId    Int
  chatbot      Chatbot   @relation(fields: [chatbotId], references: [id])
  orgId        Int
  sessionId    String    // client-generated UUID per browser/device session
  channel      String    @default("web") // web | sandbox | whatsapp | facebook
  status       String    @default("open") // open | resolved | escalated
  contactId    Int?      // nullable — linked CRM contact
  contact      Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  summary      String?   // AI-generated summary produced when conversation resolves
  metadata     String?   // JSON (IP, user-agent, etc.)
  // Denormalized current assignee — updated on every pickup / forward
  assignedToId Int?
  assignedTo   User?     @relation("ConversationAssignee", fields: [assignedToId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  messages     ConversationMessage[]
  events       ConversationEvent[]
  quotes       Quote[]

  @@index([chatbotId])
  @@index([orgId])
  @@index([sessionId])
  @@index([assignedToId])
}

model ConversationEvent {
  id             Int          @id @default(autoincrement())
  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  // who acted
  userId         Int
  user           User         @relation("ConversationEventActor", fields: [userId], references: [id])
  // event type
  type           String       // picked_up | forwarded | resolved | reopened
  // for 'forwarded': the agent who received the conversation
  toUserId       Int?
  toUser         User?        @relation("ConversationEventTarget", fields: [toUserId], references: [id])
  note           String?      // optional handoff/close note
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@index([userId])
  @@index([toUserId])
}

model ConversationMessage {
  id             Int          @id @default(autoincrement())
  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String       // user | assistant | agent
  content        String
  // Agent attribution (null for user/assistant messages)
  userId         Int?
  agentName      String?      // denormalized — avoids join on every poll
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@index([userId])
}

// ─── Notification model ──────────────────────────────────────────────────────

// Notification model - in-app notifications
model Notification {
  id            Int       @id @default(autoincrement())
  type          String    // task_reminder, new_contact, deal_won, deal_lost, task_assigned, mention, etc.
  title         String
  message       String?
  link          String?   // URL to navigate when clicked (e.g., /tasks?id=123)
  isRead        Boolean   @default(false)
  readAt        DateTime?
  metadata      String?   // JSON for extra data (entityType, entityId, etc.)
  userId        Int       // User to notify
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId Int      // Organization context
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())

  @@index([userId, isRead])
  @@index([organizationId])
  @@index([createdAt])
}

model ChannelConfig {
  id            Int       @id @default(autoincrement())
  orgId         Int
  org           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  chatbotId     Int
  chatbot       Chatbot   @relation(fields: [chatbotId], references: [id], onDelete: Cascade)
  channel       String    // telegram | whatsapp | facebook
  credentials   String    // AES-256-GCM encrypted JSON — never returned to client raw
  isActive      Boolean   @default(false)
  // Channel-specific routing keys (plaintext — used for inbound webhook lookup)
  botUsername   String?   // Telegram: @botname
  phoneNumberId String?   // WhatsApp: WABA phone number ID
  pageId        String?   // Facebook: page ID
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([chatbotId, channel])
  @@index([orgId])
  @@index([phoneNumberId])
  @@index([pageId])
}

// ── Quotes ────────────────────────────────────────────────────────────────────
// Quotes are created by agents manually or by the chatbot via Claude tool-use.
// Items are stored as JSON: [{description, qty, unitPrice, total}]
// The number field uses an org-scoped sequential format: Q-{year}-{seq}
model Quote {
  id             Int       @id @default(autoincrement())
  orgId          Int
  number         String    // e.g. "Q-2024-001"
  status         String    @default("draft") // draft | sent | accepted | rejected | expired

  // Optional CRM associations
  contactId      Int?
  contact        Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  dealId         Int?
  deal           Deal?         @relation(fields: [dealId], references: [id], onDelete: SetNull)

  // Origin — which conversation/chatbot generated this (may be null for manual quotes)
  conversationId Int?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  chatbotId      Int?
  chatbot        Chatbot?      @relation(fields: [chatbotId], references: [id], onDelete: SetNull)

  // Line items (JSON array) + totals
  items          String    // JSON: [{description: string, qty: number, unitPrice: number, total: number}]
  subtotal       Float     @default(0)
  taxRate        Float     @default(0)    // e.g. 0.16 for 16% IVA
  tax            Float     @default(0)
  total          Float     @default(0)
  currency       String    @default("MXN")
  notes          String?
  validUntil     DateTime?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([orgId])
  @@index([contactId])
  @@index([dealId])
  @@index([conversationId])
}
