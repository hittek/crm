# ─── Database ─────────────────────────────────────────────────────────────────
# Set automatically by docker-compose using POSTGRES_USER/PASSWORD/DB below.
# Uncomment and set manually only if connecting to an external PostgreSQL.
# DATABASE_URL="postgresql://crm:password@localhost:5432/crm_db"

POSTGRES_USER=crm
POSTGRES_PASSWORD=changeme_strong_password_here
POSTGRES_DB=crm_db

# ─── Session ──────────────────────────────────────────────────────────────────
# At least 32 chars. Generate: openssl rand -base64 32
SESSION_SECRET=your-secure-session-secret-at-least-32-characters

# ─── Encryption (channel credentials) ────────────────────────────────────────
# 64-char hex. Generate: openssl rand -hex 32
ENCRYPTION_KEY=your-64-char-hex-encryption-key-here

# ─── AI / Embeddings ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
VOYAGE_API_KEY=pa-...

# ─── App URL (used for webhook callbacks, share links) ────────────────────────
# Set to your ngrok static domain or custom domain
NEXT_PUBLIC_APP_URL=https://crm-hittek.ngrok.app
NEXT_PUBLIC_BASE_URL=https://crm-hittek.ngrok.app

# ─── ngrok ────────────────────────────────────────────────────────────────────
NGROK_AUTHTOKEN=your-ngrok-auth-token
NGROK_DOMAIN=crm-hittek.ngrok.app

# ─── Stripe (billing) ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...

# ─── Internal API ─────────────────────────────────────────────────────────────
# Used by internal endpoints (/api/internal/*). Generate: openssl rand -hex 16
INTERNAL_API_SECRET=your-internal-api-secret

# ─── Telegram (channel integration + system alerts) ───────────────────────
# Bot token from @BotFather. Chat ID: send a message to the bot then call
# GET https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat_id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── File storage ─────────────────────────────────────────────────────────────
# Local (default for self-hosted). Leave BLOB_READ_WRITE_TOKEN unset.
# UPLOADS_DIR defaults to /data/uploads (Docker volume).
# UPLOADS_DIR=/data/uploads

# Vercel Blob (legacy, only for Vercel deployments):
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# ─── Prisma Accelerate (legacy, only for Vercel deployments) ──────────────────
# Leave unset for self-hosted. App uses DATABASE_URL directly.
# PRISMA_DATABASE_URL=prisma://accelerate.prisma-data.net/?api_key=...
